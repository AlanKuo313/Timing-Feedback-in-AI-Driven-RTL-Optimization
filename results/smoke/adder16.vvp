#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5a4d47b91000 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5a4d47b91190 .scope module, "tb_adder16" "tb_adder16" 3 2;
 .timescale -9 -12;
v0x5a4d47baad80_0 .var "a", 15 0;
v0x5a4d47baae60_0 .var "b", 15 0;
v0x5a4d47baaf00_0 .var "clk", 0 0;
v0x5a4d47bab000_0 .var/i "cycle", 31 0;
v0x5a4d47bab0a0_0 .var "expected", 16 0;
v0x5a4d47bab1b0_0 .var/i "k", 31 0;
v0x5a4d47bab290_0 .var "prev_a", 15 0;
v0x5a4d47bab370_0 .var "prev_b", 15 0;
v0x5a4d47bab450_0 .net "sum", 16 0, v0x5a4d47baac20_0;  1 drivers
E_0x5a4d47b92d60 .event negedge, v0x5a4d47baab10_0;
S_0x5a4d47b56500 .scope module, "dut" "adder16" 3 10, 4 2 0, S_0x5a4d47b91190;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 16 "a";
    .port_info 2 /INPUT 16 "b";
    .port_info 3 /OUTPUT 17 "sum";
v0x5a4d47b80000_0 .net "a", 15 0, v0x5a4d47baad80_0;  1 drivers
v0x5a4d47baa890_0 .var "a_reg", 15 0;
v0x5a4d47baa970_0 .net "b", 15 0, v0x5a4d47baae60_0;  1 drivers
v0x5a4d47baaa30_0 .var "b_reg", 15 0;
v0x5a4d47baab10_0 .net "clk", 0 0, v0x5a4d47baaf00_0;  1 drivers
v0x5a4d47baac20_0 .var "sum", 16 0;
E_0x5a4d47b926d0 .event posedge, v0x5a4d47baab10_0;
    .scope S_0x5a4d47b56500;
T_0 ;
    %wait E_0x5a4d47b926d0;
    %load/vec4 v0x5a4d47b80000_0;
    %assign/vec4 v0x5a4d47baa890_0, 0;
    %load/vec4 v0x5a4d47baa970_0;
    %assign/vec4 v0x5a4d47baaa30_0, 0;
    %pushi/vec4 0, 0, 1;
    %load/vec4 v0x5a4d47baa890_0;
    %concat/vec4; draw_concat_vec4
    %pushi/vec4 0, 0, 1;
    %load/vec4 v0x5a4d47baaa30_0;
    %concat/vec4; draw_concat_vec4
    %add;
    %assign/vec4 v0x5a4d47baac20_0, 0;
    %jmp T_0;
    .thread T_0;
    .scope S_0x5a4d47b91190;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a4d47baaf00_0, 0, 1;
    %pushi/vec4 0, 0, 16;
    %store/vec4 v0x5a4d47baad80_0, 0, 16;
    %pushi/vec4 0, 0, 16;
    %store/vec4 v0x5a4d47baae60_0, 0, 16;
    %pushi/vec4 0, 0, 16;
    %store/vec4 v0x5a4d47bab290_0, 0, 16;
    %pushi/vec4 0, 0, 16;
    %store/vec4 v0x5a4d47bab370_0, 0, 16;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5a4d47bab000_0, 0, 32;
    %end;
    .thread T_1, $init;
    .scope S_0x5a4d47b91190;
T_2 ;
    %delay 5000, 0;
    %load/vec4 v0x5a4d47baaf00_0;
    %inv;
    %store/vec4 v0x5a4d47baaf00_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_0x5a4d47b91190;
T_3 ;
    %wait E_0x5a4d47b926d0;
    %load/vec4 v0x5a4d47bab000_0;
    %cmpi/s 0, 0, 32;
    %flag_or 5, 4; GT is !LE
    %flag_inv 5;
    %jmp/0xz  T_3.0, 5;
    %pushi/vec4 0, 0, 1;
    %load/vec4 v0x5a4d47bab290_0;
    %concat/vec4; draw_concat_vec4
    %pushi/vec4 0, 0, 1;
    %load/vec4 v0x5a4d47bab370_0;
    %concat/vec4; draw_concat_vec4
    %add;
    %store/vec4 v0x5a4d47bab0a0_0, 0, 17;
    %delay 1000, 0;
    %load/vec4 v0x5a4d47bab450_0;
    %load/vec4 v0x5a4d47bab0a0_0;
    %cmp/ne;
    %jmp/0xz  T_3.2, 6;
    %vpi_call/w 3 15 "$fatal", 32'sb00000000000000000000000000000001, "Adder mismatch cycle %0d: got %h expected %h", v0x5a4d47bab000_0, v0x5a4d47bab450_0, v0x5a4d47bab0a0_0 {0 0 0};
T_3.2 ;
T_3.0 ;
    %load/vec4 v0x5a4d47baad80_0;
    %store/vec4 v0x5a4d47bab290_0, 0, 16;
    %load/vec4 v0x5a4d47baae60_0;
    %store/vec4 v0x5a4d47bab370_0, 0, 16;
    %load/vec4 v0x5a4d47bab000_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5a4d47bab000_0, 0, 32;
    %jmp T_3;
    .thread T_3;
    .scope S_0x5a4d47b91190;
T_4 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5a4d47bab1b0_0, 0, 32;
T_4.0 ;
    %load/vec4 v0x5a4d47bab1b0_0;
    %cmpi/s 250, 0, 32;
    %jmp/0xz T_4.1, 5;
    %wait E_0x5a4d47b92d60;
    %vpi_func 3 25 "$random" 32 {0 0 0};
    %pad/s 16;
    %store/vec4 v0x5a4d47baad80_0, 0, 16;
    %vpi_func 3 26 "$random" 32 {0 0 0};
    %pad/s 16;
    %store/vec4 v0x5a4d47baae60_0, 0, 16;
    %load/vec4 v0x5a4d47bab1b0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5a4d47bab1b0_0, 0, 32;
    %jmp T_4.0;
T_4.1 ;
    %wait E_0x5a4d47b92d60;
    %load/vec4 v0x5a4d47bab000_0;
    %subi 1, 0, 32;
    %vpi_call/w 3 29 "$display", "PASS: adder16 %0d vectors", S<0,vec4,s32> {1 0 0};
    %vpi_call/w 3 30 "$finish" {0 0 0};
    %end;
    .thread T_4;
